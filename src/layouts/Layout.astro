---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';

import { site, contact, social, serviceAreas } from '../data/site';
import { services } from '../data/services';
import { asset } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Ruta dentro de public/, sin el prefijo de base */
  ogImage?: string;
}

const { title, description, ogImage = 'og.jpg' } = Astro.props;

/** URLs públicas, con el subdirectorio de GitHub Pages ya incluido. */
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin).href;
const homeUrl = new URL(asset('/'), origin).href;
const ogImageUrl = new URL(asset(ogImage), origin).href;

/** Datos estructurados: ayuda a que Google muestre teléfono, horario y estrellas. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  '@id': `${homeUrl}#business`,
  name: site.name,
  alternateName: site.shortName,
  url: homeUrl,
  telephone: contact.phoneRaw,
  email: contact.email,
  image: ogImageUrl,
  priceRange: '$$',
  // Licencia estatal como dato estructurado: refuerza la confianza en buscadores
  identifier: {
    '@type': 'PropertyValue',
    name: 'Oregon CCB license',
    value: site.ccb.replace(/\D/g, ''),
    url: social.ccbSearch,
  },
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressRegion: contact.address.region,
    postalCode: contact.address.postalCode,
    addressCountry: contact.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: contact.geo.lat,
    longitude: contact.geo.lng,
  },
  areaServed: serviceAreas.map((city) => ({
    '@type': 'City',
    name: `${city}, OR`,
  })),
  knowsLanguage: ['en', 'es'],
  sameAs: [social.facebook, social.homeAdvisor, social.googleMaps],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '10:00',
      closes: '16:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '3',
    bestRating: '5',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Painting services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.en.name, description: s.en.desc },
    })),
  },
};
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#0e1a24" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('favicon.svg')} />

    <!-- El iframe del mapa se carga en diferido; adelantamos la conexión -->
    <link rel="preconnect" href="https://maps.google.com" />

    <script is:inline>
      // Restaura el idioma antes del primer pintado para que no haya parpadeo.
      try {
        var stored = localStorage.getItem('rc-lang');
        var browser = (navigator.language || 'en').toLowerCase().indexOf('es') === 0 ? 'es' : 'en';
        var lang = stored === 'es' || stored === 'en' ? stored : browser;
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      } catch (e) {}
    </script>

    <noscript>
      <style>
        /* Sin JS no hay IntersectionObserver: el contenido se muestra tal cual */
        .reveal {
          opacity: 1 !important;
          translate: none !important;
        }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">
      <span data-t="en">Skip to content</span><span data-t="es">Ir al contenido</span>
    </a>

    <slot />

    <script>
      // --- Idioma -----------------------------------------------------------
      const root = document.documentElement;

      function setLang(lang: string) {
        root.dataset.lang = lang;
        root.lang = lang;
        try {
          localStorage.setItem('rc-lang', lang);
        } catch {
          /* modo privado */
        }
        document.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
      }

      document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]').forEach((btn) => {
        btn.addEventListener('click', () => setLang(btn.dataset.langBtn!));
      });

      // Placeholders de formulario: no se pueden duplicar como el texto
      function syncPlaceholders() {
        const lang = root.dataset.lang === 'es' ? 'es' : 'en';
        document
          .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-ph-en]')
          .forEach((el) => {
            el.placeholder = el.dataset[lang === 'es' ? 'phEs' : 'phEn'] ?? '';
          });
      }
      // Textos alternativos de imágenes: tampoco se pueden duplicar
      function syncAltText() {
        const lang = root.dataset.lang === 'es' ? 'es' : 'en';
        document.querySelectorAll<HTMLImageElement>('[data-alt-es]').forEach((img) => {
          img.alt = img.dataset[lang === 'es' ? 'altEs' : 'altEn'] ?? img.alt;
        });
      }

      function syncLangAttrs() {
        syncPlaceholders();
        syncAltText();
      }

      document.addEventListener('langchange', syncLangAttrs);
      syncLangAttrs();

      // --- Revelado al hacer scroll ----------------------------------------
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
