---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';

// Precargamos solo el subconjunto latino de cada fuente: son los archivos que
// el navegador acaba pidiendo igualmente, y adelantarlos evita el salto de
// tipografía (FOUT) que retrasa el LCP del título del hero.
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import T from '../components/T.astro';

import { site, contact, social, serviceAreas } from '../data/site';
import { services } from '../data/services';
import { asset } from '../lib/url';
import { href, langFromPath, locales, ogLocale, routes, type Alternates } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** Las dos rutas de esta misma página, una por idioma. Alimenta hreflang. */
  alternates: Alternates;
  /** Ruta dentro de public/, sin el prefijo de base */
  ogImage?: string;
  /** Nodos extra para el @graph de datos estructurados */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, alternates, ogImage = 'og.jpg', schema = [], noindex = false } =
  Astro.props;

const lang = langFromPath(Astro.url.pathname);

/** URLs absolutas. El canonical sale de `alternates` (no de Astro.url) para
 *  garantizar que coincida carácter por carácter con su entrada de hreflang. */
const origin = Astro.site ?? new URL(site.url);
const abs = (path: string) => new URL(href(path), origin).href;

const canonical = abs(alternates[lang]);
const homeUrl = new URL(asset('/'), origin).href;
const ogImageUrl = new URL(asset(ogImage), origin).href;
/** Logo cuadrado y rasterizado: es el formato que Google pide para asociar
 *  una marca a su icono en resultados y en el panel de conocimiento. */
const logoUrl = new URL(asset('icon-512.png'), origin).href;

/** Datos estructurados del negocio: se repiten en todas las páginas a
 *  propósito, para que cualquier página pueda entrar como resultado local. */
const business = {
  '@type': 'HousePainter',
  '@id': `${homeUrl}#business`,
  name: site.name,
  alternateName: site.shortName,
  url: homeUrl,
  telephone: contact.phoneRaw,
  email: contact.email,
  image: ogImageUrl,
  logo: {
    '@type': 'ImageObject',
    '@id': `${homeUrl}#logo`,
    url: logoUrl,
    contentUrl: logoUrl,
    width: 512,
    height: 512,
    caption: site.name,
  },
  priceRange: '$$',
  // Licencia estatal como dato estructurado: refuerza la confianza en buscadores
  identifier: {
    '@type': 'PropertyValue',
    name: 'Oregon CCB license',
    value: site.ccb.replace(/\D/g, ''),
    url: social.ccbSearch,
  },
  foundingDate: String(site.foundedYear),
  /* Sin `streetAddress` a propósito: es un service-area business sin local
     abierto al público, así que la dirección declarada llega hasta la ciudad y
     el código postal. Debe coincidir con lo que muestra la web y con lo que
     tiene el perfil de Google, que es la señal NAP que Google compara. */
  address: {
    '@type': 'PostalAddress',
    addressLocality: contact.address.city,
    addressRegion: contact.address.region,
    postalCode: contact.address.postalCode,
    addressCountry: contact.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: contact.geo.lat,
    longitude: contact.geo.lng,
  },
  description: site.tagline[lang],
  /** Beaverton es la sede: se declara aparte para que no quede como una ciudad
   *  más de la lista. */
  areaServed: [
    {
      '@type': 'GeoCircle',
      name: `${contact.address.city}, ${contact.address.region} and surrounding area`,
      geoMidpoint: {
        '@type': 'GeoCoordinates',
        latitude: contact.geo.lat,
        longitude: contact.geo.lng,
      },
      /* En metros. Se deriva de las millas declaradas en la web para que el
         dato estructurado no se despegue del texto visible. */
      geoRadius: String(Math.round(contact.serviceRadiusMiles * 1609.34)),
    },
    ...serviceAreas.map((city) => ({
      '@type': 'City',
      name: `${city}, ${contact.address.region}`,
    })),
  ],
  knowsLanguage: ['en', 'es'],
  sameAs: [social.facebook, social.homeAdvisor, social.googleMaps],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '10:00',
      closes: '16:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '3',
    bestRating: '5',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Painting services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.en.name, description: s.en.desc },
    })),
  },
};

/** Nodo `WebSite` en la home. Es de donde Google saca el "nombre del sitio"
 *  que muestra encima del título del resultado: sin él cae en el dominio a
 *  secas ("rcenterprisepainting.com"). Solo lo lee de la portada, así que se
 *  emite únicamente ahí. */
const isHome = alternates[lang] === routes.home[lang];
const website = {
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  url: homeUrl,
  name: site.shortName,
  alternateName: [site.name, 'RC Enterprise Painting'],
  inLanguage: lang,
  publisher: { '@id': `${homeUrl}#business` },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [business, ...(isHome ? [website] : []), ...schema],
};

/** El otro idioma, solo para `og:locale:alternate`. */
const otherLang = lang === 'en' ? 'es' : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* hreflang recíproco. Cada página se incluye a sí misma (autorreferencia),
        que es el requisito que más se incumple y hace que Google ignore todo
        el grupo. El x-default apunta a inglés, el idioma principal. */}
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={abs(alternates[l])} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.shortName} — ${site.tagline[lang]}`} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#0e1a24" />

    {/* Iconos. Google necesita un favicon rasterizado alcanzable para mostrar
        el logo junto al resultado: el .ico en la raíz es el que rastrea por
        defecto y el PNG de 48px es el tamaño que documenta como referencia.
        El SVG queda como versión nítida para navegadores modernos. */}
    <link rel="icon" href={asset('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} sizes="any" />
    <link rel="icon" type="image/png" href={asset('icon-96.png')} sizes="96x96" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <link rel="preload" as="font" type="font/woff2" href={bricolageLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentLatin} crossorigin />

    <!-- El iframe del mapa se carga en diferido; adelantamos la conexión -->
    <link rel="preconnect" href="https://maps.google.com" />

    <noscript>
      <style>
        /* Sin JS no hay IntersectionObserver: el contenido se muestra tal cual */
        .reveal {
          opacity: 1 !important;
          translate: none !important;
        }
      </style>
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">
      <T en="Skip to content" es="Ir al contenido" />
    </a>

    <Header alternates={alternates} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <FloatingActions />

    <script>
      // --- Revelado al hacer scroll ----------------------------------------
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
