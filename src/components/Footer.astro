---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import T from './T.astro';
import Wordmark from './Wordmark.astro';
import { contact, site, social } from '../data/site';
import { services } from '../data/services';
import { homeAnchor, href, langFromPath, routes, servicePaths } from '../lib/i18n';
import logo from '../assets/logo.png';

const year = new Date().getFullYear();
const lang = langFromPath(Astro.url.pathname);

const logoAlt = {
  en: 'Residential Construction Enterprise LLC logo',
  es: 'Logotipo de Residential Construction Enterprise LLC',
};
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Wordmark size={40} />
      <p class="footer__blurb">
        <T
          en="Residential painting, staining and power washing across the Portland metro since 1998."
          es="Pintura residencial, teñido y lavado a presión en el área de Portland desde 1998."
        />
      </p>
      <Image
        src={logo}
        alt={logoAlt[lang]}
        width={220}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="footer__card"
      />
    </div>

    {/* Enlazar cada página de servicio desde el pie es lo que las saca de ser
        huérfanas: es la señal de enlazado interno más barata que hay, y es de
        donde Google construye los sitelinks. */}
    <nav class="footer__col" aria-label={lang === 'es' ? 'Servicios' : 'Services'}>
      <h2 class="footer__heading"><T en="Services" es="Servicios" /></h2>
      <ul>
        {
          services.map((s) => (
            <li>
              <a href={href(servicePaths(s.slug)[lang])}>{s[lang].name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Footer">
      <h2 class="footer__heading"><T en="Sections" es="Secciones" /></h2>
      <ul>
        <li><a href={homeAnchor('work', lang)}><T en="Work" es="Trabajos" /></a></li>
        <li><a href={homeAnchor('reviews', lang)}><T en="Reviews" es="Reseñas" /></a></li>
        <li><a href={homeAnchor('area', lang)}><T en="Service area" es="Zona de servicio" /></a></li>
        <li>
          <a href={href(routes.contact[lang])}><T en="Free estimate" es="Estimado gratis" /></a>
        </li>
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading"><T en="Contact" es="Contacto" /></h2>
      <ul>
        <li><a href={`tel:${contact.phoneRaw}`}>{contact.phone}</a></li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>
          {contact.address.city}, {contact.address.region} {contact.address.postalCode}
        </li>
      </ul>

      <div class="footer__social">
        <a
          href={social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="footer__social-btn"
        >
          <Icon name="facebook" size={20} />
        </a>
        <a
          href={`https://wa.me/${contact.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="footer__social-btn"
        >
          <Icon name="whatsapp" size={20} />
        </a>
        <a
          href={social.googleMaps}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Google Maps"
          class="footer__social-btn"
        >
          <Icon name="pin" size={20} />
        </a>
      </div>
    </div>
  </div>

  <div class="container footer__legal">
    <p>© {year} {site.name}</p>
    <p>
      <a href={social.ccbSearch} class="footer__ccb" target="_blank" rel="noopener noreferrer">
        {site.ccb}
        <span class="sr-only">
          <T
            en=" — verify on the Oregon CCB license search (opens in a new tab)"
            es=" — verificar en el buscador de licencias de la Oregon CCB (abre en pestaña nueva)"
          />
        </span>
      </a>
      · <T en="Licensed & insured" es="Con licencia y asegurado" />
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-900);
    border-top: 1px solid var(--border-dark);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .footer__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .footer__blurb {
    max-width: 40ch;
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--text-on-dark-muted);
  }

  .footer__card {
    width: 220px;
    height: auto;
    margin-top: 1.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-dark);
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-300);
    margin-bottom: 0.9rem;
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-on-dark-muted);
  }

  .footer__col a:hover {
    color: var(--text-on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .footer__social-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    color: var(--text-on-dark);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .footer__social-btn:hover {
    border-color: var(--teal-300);
    background: rgb(255 255 255 / 0.05);
  }

  .footer__ccb {
    text-decoration: underline;
    text-decoration-color: var(--border-dark-strong);
    text-underline-offset: 3px;
    transition: color var(--dur) var(--ease-out);
  }

  .footer__ccb:hover {
    color: var(--teal-300);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-dark);
    font-size: 0.78rem;
    color: var(--text-on-dark-muted);
  }

  @media (min-width: 760px) {
    .footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .footer__inner {
      grid-template-columns: 1.4fr 1fr 0.9fr 1fr;
    }
  }
</style>
