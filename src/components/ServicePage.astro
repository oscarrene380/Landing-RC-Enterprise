---
/**
 * Plantilla de una página de servicio. La comparten los 10 destinos
 * (5 servicios × 2 idiomas); el idioma sale de la ruta.
 */
import Icon from './Icon.astro';
import { services, type Service } from '../data/services';
import { servicePages } from '../data/servicePages';
import { contact, primaryArea, nearbyAreas } from '../data/site';
import { href, langFromPath, routes, servicePaths, ui } from '../lib/i18n';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = ui[lang];
const copy = servicePages[service.id][lang];

const others = services.filter((s) => s.id !== service.id);
---

<article class="sp">
  <header class="sp__hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href(routes.home[lang])}>{t.breadcrumbHome}</a>
        <span aria-hidden="true">/</span>
        <span>{copy.h1}</span>
      </nav>

      <p class="eyebrow">
        {t.servicesEyebrow} {service.n}
      </p>
      {/* La ciudad va dentro del H1, no en un subtítulo: es la señal local más
          fuerte que tiene la página y la comparten los 10 destinos. */}
      <h1 class="sp__title">
        {copy.h1}<span class="sp__title-city">
          {lang === 'es' ? ' en ' : ' in '}{primaryArea}, {contact.address.region}
        </span>
      </h1>
      <p class="lede sp__lede">{copy.lede}</p>

      <div class="sp__actions">
        <a href={`tel:${contact.phoneRaw}`} class="btn btn--primary">
          <Icon name="phone" size={19} />
          {t.ctaCall}
        </a>
        <a href={href(routes.contact[lang])} class="btn btn--ghost">
          {t.ctaContact}
          <Icon name="arrowRight" size={19} />
        </a>
      </div>
    </div>
  </header>

  <div class="section section--light">
    <div class="container sp__body">
      <div class="prose reveal">
        {copy.intro.map((p) => <p>{p}</p>)}
      </div>

      <section class="sp__block reveal">
        <h2 class="sp__h2">{t.whatsIncluded}</h2>
        <ul class="blocks">
          {
            copy.includes.map((b) => (
              <li class="block">
                <h3 class="block__h">{b.h}</h3>
                <p class="block__p">{b.p}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="sp__block reveal">
        <h2 class="sp__h2">{t.howItGoes}</h2>
        <ol class="steps">
          {
            copy.process.map((b, i) => (
              <li class="step">
                <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="block__h">{b.h}</h3>
                  <p class="block__p">{b.p}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <p class="sp__closing reveal">{copy.closing}</p>

      <section class="sp__block reveal" aria-label={t.servingLabel}>
        <h2 class="sp__h2">{t.servingLabel}</h2>
        <ul class="cities">
          <li class="city city--home">
            <Icon name="pin" size={14} />
            {primaryArea}, {contact.address.region}
          </li>
          {nearbyAreas.map((city) => <li class="city">{city}, {contact.address.region}</li>)}
        </ul>
      </section>
    </div>
  </div>

  <section class="section sp__cta">
    <div class="container sp__cta-inner">
      <div>
        <h2 class="sp__cta-title">{t.ctaTitle}</h2>
        <p class="lede">{t.ctaText}</p>
      </div>
      <div class="sp__actions">
        <a href={`tel:${contact.phoneRaw}`} class="btn btn--primary">
          <Icon name="phone" size={19} />
          {contact.phone}
        </a>
        <a href={href(routes.contact[lang])} class="btn btn--ghost">
          {t.ctaContact}
          <Icon name="arrowRight" size={19} />
        </a>
      </div>
    </div>
  </section>

  <nav class="section section--light sp__others" aria-label={t.otherServices}>
    <div class="container">
      <h2 class="sp__h2">{t.otherServices}</h2>
      <ul class="others">
        {
          others.map((s) => (
            <li>
              <a class="other" href={href(servicePaths(s.slug)[lang])}>
                <Icon name={s.icon as any} size={22} class="other__icon" />
                <span>
                  <span class="other__name">{s[lang].name}</span>
                  <span class="other__desc">{s[lang].desc}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</article>

<style>
  .sp__hero {
    background:
      radial-gradient(120% 90% at 15% 0%, var(--ink-700), transparent 60%),
      var(--ink-800);
    padding-block: clamp(2.25rem, 6vw, 4.5rem);
    color: var(--text-on-dark);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-on-dark-muted);
    margin-bottom: 1.5rem;
  }

  .crumbs a:hover {
    color: var(--text-on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sp__title {
    font-size: var(--step-6);
    text-transform: uppercase;
    margin: 0.6rem 0 1rem;
    max-width: 20ch;
  }

  /* La ciudad se lee como segunda línea del titular, no como un añadido */
  .sp__title-city {
    color: var(--coral-500);
  }

  .sp__lede {
    max-width: 58ch;
  }

  .sp__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .sp__body {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.5rem);
    max-width: 78ch;
  }

  .prose p {
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--text-on-light);
  }

  .prose p + p {
    margin-top: 1.1rem;
  }

  .sp__h2 {
    font-size: var(--step-3);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .blocks,
  .steps,
  .cities,
  .others {
    list-style: none;
    padding: 0;
  }

  .blocks {
    display: grid;
    gap: 1rem;
  }

  .block {
    border-left: 2px solid var(--coral-500);
    padding-left: 1rem;
  }

  .block__h {
    font-size: var(--step-0);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .block__p {
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text-on-light-muted);
  }

  .steps {
    display: grid;
    gap: 1.25rem;
  }

  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--text-on-light-muted);
    padding-top: 0.25rem;
    flex: none;
  }

  .sp__closing {
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text-on-light-muted);
    border-top: 1px solid var(--border-light);
    padding-top: 1.5rem;
  }

  .cities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .city {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-pill);
    background: var(--paper-50);
    font-size: 0.82rem;
    font-weight: 500;
  }

  /* La ciudad base sale del gris: es donde estamos y donde queremos rankear */
  .city--home {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-color: var(--coral-500);
    background: color-mix(in srgb, var(--coral-500) 8%, transparent);
    font-weight: 700;
  }

  .city--home :global(svg) {
    color: var(--coral-500);
  }

  .sp__cta {
    background: linear-gradient(180deg, var(--ink-900), var(--ink-800));
    color: var(--text-on-dark);
  }

  .sp__cta-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .sp__cta-title {
    font-size: var(--step-4);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .others {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0.9rem;
  }

  .other {
    display: flex;
    gap: 0.85rem;
    height: 100%;
    padding: 1.1rem;
    background: var(--paper-50);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    color: var(--text-on-light);
    transition:
      border-color var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }

  .other:hover {
    border-color: var(--coral-500);
    translate: 0 -3px;
  }

  .other__icon {
    color: var(--coral-500);
    flex: none;
  }

  .other__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--step--1);
    margin-bottom: 0.3rem;
  }

  .other__desc {
    display: block;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-on-light-muted);
  }

  @media (min-width: 900px) {
    .blocks {
      grid-template-columns: repeat(2, 1fr);
    }

    .sp__cta-inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .sp__cta-inner .sp__actions {
      margin-top: 0;
      justify-content: flex-end;
    }
  }
</style>
