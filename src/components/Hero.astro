---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import T from './T.astro';
import { contact, site, social } from '../data/site';
import { heroImage, heroAlt } from '../data/gallery';
import { ratingSummary } from '../data/reviews';
import { langFromPath } from '../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
---

<section id="top" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow eyebrow">
        <T en="Painting & staining · Portland metro, OR" es="Pintura y teñido · Área de Portland, OR" />
      </p>

      <h1 class="hero__title">
        <T en="House painting in the Portland metro," es="Pintura de casas en el área de Portland," block />
        <span class="hero__title-accent">
          <T en="done right since 1998." es="bien hecha desde 1998." />
        </span>
      </h1>

      <p class="hero__lede lede">
        <T
          en="Interior, exterior, staining and power washing. Clean job sites, honest quotes, and a crew that has been doing this for 27 years."
          es="Interior, exterior, teñido y lavado a presión. Obra limpia, estimados honestos y un equipo que lleva 27 años haciendo esto."
        />
      </p>

      <div class="hero__actions">
        <a href={`tel:${contact.phoneRaw}`} class="btn btn--primary">
          <Icon name="phone" size={19} />
          <T en="Call for a free estimate" es="Llama por tu estimado gratis" />
        </a>
        <a href="#work" class="btn btn--ghost">
          <T en="See our work" es="Ver trabajos" />
          <Icon name="arrowRight" size={19} />
        </a>
      </div>

      <p class="hero__rating">
        <span class="hero__stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={17} filled />)}
        </span>
        <span>
          <strong>{ratingSummary.value.toFixed(1)}</strong>
          <span aria-hidden="true"> · </span>
          <a
            href={social.ccbSearch}
            class="hero__ccb"
            target="_blank"
            rel="noopener noreferrer"
          >
            {site.ccb}
            <span class="sr-only">
              <T
                en=" — verify this license on the Oregon CCB search (opens in a new tab)"
                es=" — verifica esta licencia en el buscador de la Oregon CCB (abre en pestaña nueva)"
              />
            </span>
            <Icon name="arrowUpRight" size={13} class="hero__ccb-icon" />
          </a>
        </span>
      </p>
    </div>

    <figure class="hero__media">
      <Image
        src={heroImage}
        alt={heroAlt[lang]}
        widths={[520, 760, 1100]}
        sizes="(min-width: 900px) 46vw, 92vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <figcaption class="hero__badge">
        <T en="Recent exterior — Portland" es="Exterior reciente — Portland" />
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 90% at 15% 0%, var(--ink-700), transparent 60%),
      var(--ink-800);
    overflow: hidden;
  }

  /* Trama diagonal muy sutil, como cinta de enmascarar */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(255 255 255 / 0.022) 0 2px,
      transparent 2px 14px
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
    padding-block: clamp(2.75rem, 7vw, 5.5rem);
  }

  .hero__eyebrow {
    margin-bottom: 1.1rem;
  }

  .hero__title {
    font-size: var(--step-6);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .hero__title-accent {
    color: var(--coral-500);
  }

  .hero__lede {
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--text-on-dark-muted);
  }

  .hero__rating strong {
    color: var(--text-on-dark);
  }

  .hero__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--coral-400);
  }

  /* La licencia es un dato verificable: se marca como enlace sin gritar */
  .hero__ccb {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    color: var(--text-on-dark);
    text-decoration: underline;
    text-decoration-color: var(--border-dark-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    white-space: nowrap;
    transition:
      color var(--dur) var(--ease-out),
      text-decoration-color var(--dur) var(--ease-out);
  }

  .hero__ccb:hover {
    color: var(--teal-300);
    text-decoration-color: currentColor;
  }

  .hero__ccb-icon {
    opacity: 0.6;
  }

  .hero__ccb:hover .hero__ccb-icon {
    opacity: 1;
  }

  .hero__media {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-dark);
    background: var(--ink-700);
  }

  .hero__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero__badge {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ink-900) 82%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
    }

    .hero__media {
      /* Desborde controlado: rompe la retícula y da profundidad */
      margin-right: calc(var(--gutter) * -0.5);
    }

    .hero__img {
      aspect-ratio: 5 / 4;
    }
  }
</style>
