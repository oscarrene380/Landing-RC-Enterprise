---
/**
 * Texto bilingüe. Emite SOLO el idioma de la página actual, deducido de la
 * ruta durante el build (`/` → en, `/es/…` → es).
 *
 * Antes se emitían los dos idiomas y CSS ocultaba uno: cómodo, pero Google
 * veía el mismo contenido duplicado en dos idiomas dentro de un solo
 * documento, lo que diluye las keywords y ensucia el snippet.
 *
 * Uso: <T en="Services" es="Servicios" />
 */
import { langFromPath } from '../lib/i18n';

interface Props {
  en: string;
  es: string;
  /** Fuerza un salto de línea (útil dentro de títulos). */
  block?: boolean;
}

const { en, es, block = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const text = lang === 'es' ? es : en;
---

{block ? <span class="t-block">{text}</span> : text}
