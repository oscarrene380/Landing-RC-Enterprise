---
/**
 * Iconos SVG inline. Sin dependencias ni peticiones extra.
 * Trazo de 1.75 para que se lean bien sobre fondos oscuros.
 */
/**
 * Hereda los atributos de <svg> para poder reenviar cualquier extra al elemento.
 * Esto incluye el `data-astro-cid-*` que Astro inyecta cuando el componente
 * padre le aplica estilos con scope: sin reenviarlo, esas reglas no aplican.
 */
interface Props extends Omit<astroHTML.JSX.SVGAttributes, 'name'> {
  name: keyof typeof paths;
  size?: number | string;
  /** Dibuja el icono relleno en vez de con trazo (estrellas, logos de marca) */
  filled?: boolean;
}

const paths = {
