} as const;

/**
 * Regla del set de iconos: las marcas van rellenas, los iconos de interfaz
 * van con trazo. Mezclar ambos estilos en una misma marca la desdibuja.
 */
const alwaysFilled = new Set(['facebook', 'google', 'whatsapp']);

const { name, size = 24, class: className, filled, ...rest } = Astro.props;
const isFilled = filled ?? alwaysFilled.has(name);
---

<svg
  {...rest}
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
