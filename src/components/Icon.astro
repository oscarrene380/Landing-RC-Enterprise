    '<path d="M3.5 5.5c0-1.1.9-2 2-2h2.2c.5 0 .9.3 1 .8l.9 3.3c.1.4 0 .8-.4 1l-1.6 1.2a12.5 12.5 0 0 0 5.6 5.6l1.2-1.6c.2-.3.6-.5 1-.4l3.3.9c.5.1.8.5.8 1v2.2c0 1.1-.9 2-2 2h-.5C9.6 19.5 4.5 14.4 4.5 6v-.5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 5.5L20 7"/>',
  pin: '<path d="M20 10c0 5-8 12-8 12s-8-7-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
