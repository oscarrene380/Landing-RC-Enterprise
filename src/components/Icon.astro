---
/**
 * Iconos SVG inline. Sin dependencias ni peticiones extra.
 * Trazo de 1.75 para que se lean bien sobre fondos oscuros.
 */
interface Props {
  name: keyof typeof paths;
  size?: number | string;
  class?: string;
}

const paths = {
  phone:
    '<path d="M3.5 5.5c0-1.1.9-2 2-2h2.2c.5 0 .9.3 1 .8l.9 3.3c.1.4 0 .8-.4 1l-1.6 1.2a12.5 12.5 0 0 0 5.6 5.6l1.2-1.6c.2-.3.6-.5 1-.4l3.3.9c.5.1.8.5.8 1v2.2c0 1.1-.9 2-2 2h-.5C9.6 19.5 4.5 14.4 4.5 6v-.5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 5.5L20 7"/>',
  pin: '<path d="M20 10c0 5-8 12-8 12s-8-7-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  shield: '<path d="M12 3.2 5 6v6c0 4.2 2.9 7.6 7 8.8 4.1-1.2 7-4.6 7-8.8V6l-7-2.8Z"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  message:
    '<path d="M20.5 12.5c0 4-3.8 7.2-8.5 7.2-1 0-2-.1-2.9-.4l-5.1 1.6 1.7-4.3a6.8 6.8 0 0 1-2.2-4.9C3.5 8.5 7.3 5.3 12 5.3s8.5 3.2 8.5 7.2Z"/>',
  star: '<path d="m12 3.6 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8-4.2-4.1 5.9-.9L12 3.6Z"/>',
  arrowRight: '<path d="M4.5 12h15m-6-6 6 6-6 6"/>',
  arrowUpRight: '<path d="M7 17 17 7m0 0H8m9 0v9"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  roller:
    '<rect x="4" y="4" width="14" height="5" rx="1.5"/><path d="M18 6.5h2v4h-6v3.5"/><rect x="10" y="14" width="8" height="6" rx="1.5"/>',
  house:
    '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9.5Z"/><path d="M9.5 21v-6h5v6"/>',
  brush:
    '<path d="M8 14.5 4.5 18c-.8.8-.8 2 0 2.8s2 .8 2.8 0L11 17.3"/><path d="M13.5 4.5 20 11l-6.2 5.6a2 2 0 0 1-2.7 0l-2.7-2.4a2 2 0 0 1 0-3L13.5 4.5Z"/>',
  water:
    '<path d="M12 3.5s6 6.3 6 10.2a6 6 0 0 1-12 0C6 9.8 12 3.5 12 3.5Z"/>',
  tools:
    '<path d="m14.5 4.5 5 5-3 3-5-5 3-3Z"/><path d="m11.5 7.5-7 7v5h5l7-7"/>',
  whatsapp:
    '<path d="M12 3.8a8.1 8.1 0 0 0-7 12.2l-1.2 4.2 4.4-1.2A8.1 8.1 0 1 0 12 3.8Z"/><path d="M9.2 9c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.5l.7 1.6c.1.3 0 .5-.1.7l-.5.6c-.1.2-.2.4 0 .7.3.5 1.2 1.7 2.6 2.3.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.5 0 .8-.6 1.6-1.5 1.7-.7.1-1.6.1-4-1.2-2.2-1.3-3.3-3.4-3.4-4.2-.1-.9.4-1.9 1.1-2.6Z"/>',
  facebook:
    '<path d="M13.8 21v-8h2.7l.5-3.2h-3.2V7.7c0-.9.3-1.6 1.6-1.6H17V3.2C16.6 3.1 15.6 3 14.5 3c-2.4 0-4 1.5-4 4.2v2.6H7.8V13h2.7v8h3.3Z"/>',
  google:
    '<path d="M20.6 12.2c0-.6-.1-1.2-.2-1.8H12v3.4h4.8a4.1 4.1 0 0 1-1.8 2.7v2.2h2.9a8.7 8.7 0 0 0 2.7-6.5Z"/><path d="M12 21c2.4 0 4.5-.8 6-2.2l-2.9-2.3c-.8.5-1.8.9-3.1.9-2.4 0-4.4-1.6-5.1-3.8H3.9v2.4A9 9 0 0 0 12 21Z"/><path d="M6.9 13.6a5.4 5.4 0 0 1 0-3.4V7.8H3.9a9 9 0 0 0 0 8.1l3-2.3Z"/><path d="M12 6.6c1.3 0 2.5.5 3.5 1.4l2.6-2.6A9 9 0 0 0 3.9 7.8l3 2.4c.7-2.2 2.7-3.6 5.1-3.6Z"/>',
} as const;

/** Logos de marca: se dibujan rellenos, no con trazo */
const filled = new Set(['facebook', 'google']);

const { name, size = 24, class: className } = Astro.props;
const isFilled = filled.has(name);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
