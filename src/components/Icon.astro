  house:
    '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9.5Z"/><path d="M9.5 21v-6h5v6"/>',
  brush:
    '<path d="M8 14.5 4.5 18c-.8.8-.8 2 0 2.8s2 .8 2.8 0L11 17.3"/><path d="M13.5 4.5 20 11l-6.2 5.6a2 2 0 0 1-2.7 0l-2.7-2.4a2 2 0 0 1 0-3L13.5 4.5Z"/>',
  water:
    '<path d="M12 3.5s6 6.3 6 10.2a6 6 0 0 1-12 0C6 9.8 12 3.5 12 3.5Z"/>',
  tools:
    '<path d="m14.5 4.5 5 5-3 3-5-5 3-3Z"/><path d="m11.5 7.5-7 7v5h5l7-7"/>',
