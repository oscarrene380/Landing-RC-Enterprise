---
/**
 * Selector de idioma. Ahora son enlaces reales a la otra URL, no botones:
 * Google los sigue, y el usuario puede compartir o marcar la versión que ve.
 */
import { href, langFromPath, locales, type Alternates } from '../lib/i18n';

interface Props {
  alternates: Alternates;
}

const { alternates } = Astro.props;
const current = langFromPath(Astro.url.pathname);
---

<div class="lang" role="group" aria-label="Language / Idioma">
  {
    locales.map((l) => (
      <a
        class:list={['lang__btn', { 'is-current': l === current }]}
        href={href(alternates[l])}
        hreflang={l}
        lang={l}
        aria-current={l === current ? 'true' : undefined}
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</div>

<style>
  .lang {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    background: rgb(255 255 255 / 0.08);
    border-radius: var(--radius-pill);
  }

  .lang__btn {
    border: 0;
    background: transparent;
    color: var(--text-on-dark);
    opacity: 0.6;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    transition:
      background-color var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }

  .lang__btn:hover {
    opacity: 1;
  }

  .lang__btn.is-current {
    background: var(--paper-50);
    color: var(--ink-900);
    opacity: 1;
  }
</style>
