---
/** Páginas de servicio en español: `/es/pintura-interior/`, etc. */
import Layout from '../../layouts/Layout.astro';
import ServicePage from '../../components/ServicePage.astro';
import { services, type Service } from '../../data/services';
import { servicePages } from '../../data/servicePages';
import { routes, servicePaths, ui } from '../../lib/i18n';
import { breadcrumbs, businessId } from '../../lib/schema';
import { serviceAreas } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug.es },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const copy = servicePages[service.id].es;
const alternates = servicePaths(service.slug);

const schema = [
  {
    '@type': 'Service',
    name: copy.h1,
    serviceType: service.es.name,
    description: copy.lede,
    provider: { '@id': businessId(Astro.site) },
    areaServed: serviceAreas.map((city) => ({ '@type': 'City', name: `${city}, OR` })),
    availableLanguage: ['en', 'es'],
  },
  breadcrumbs(
    [
      { name: ui.es.breadcrumbHome, path: routes.home.es },
      { name: copy.h1, path: alternates.es },
    ],
    Astro.site,
  ),
];
---

<Layout
  title={copy.title}
  description={copy.description}
  alternates={alternates}
  schema={schema}
>
  <ServicePage service={service} />
</Layout>
