---
/** Páginas de servicio en inglés: `/interior-painting/`, etc. */
import Layout from '../layouts/Layout.astro';
import ServicePage from '../components/ServicePage.astro';
import { services, type Service } from '../data/services';
import { servicePages } from '../data/servicePages';
import { routes, servicePaths, ui } from '../lib/i18n';
import { breadcrumbs, businessId } from '../lib/schema';
import { serviceAreas } from '../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug.en },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const copy = servicePages[service.id].en;
const alternates = servicePaths(service.slug);

const schema = [
  {
    '@type': 'Service',
    name: copy.h1,
    serviceType: service.en.name,
    description: copy.lede,
    provider: { '@id': businessId(Astro.site) },
    areaServed: serviceAreas.map((city) => ({ '@type': 'City', name: `${city}, OR` })),
    availableLanguage: ['en', 'es'],
  },
  breadcrumbs(
    [
      { name: ui.en.breadcrumbHome, path: routes.home.en },
      { name: copy.h1, path: alternates.en },
    ],
    Astro.site,
  ),
];
---

<Layout
  title={copy.title}
  description={copy.description}
  alternates={alternates}
  schema={schema}
>
  <ServicePage service={service} />
</Layout>
