---
import Layout from '../layouts/Layout.astro';
import HomeSections from '../components/HomeSections.astro';
import { routes } from '../lib/i18n';

const title = 'House Painters in Portland & Beaverton, OR | RC Enterprise';
const description =
  'Interior and exterior house painting, staining and power washing across the Portland metro. 27 years of experience, free estimates, licensed & insured.';
---

